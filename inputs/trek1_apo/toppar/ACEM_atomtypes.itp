; ACEM_atomtypes.itp -- types absent from the bilayer forcefield.itp.
; Copied verbatim from ffnonbonded.itp of the CHARMM36 (July 2021) GROMACS force-field distribution.
; #include this immediately AFTER toppar/forcefield.itp and BEFORE any moleculetype.
[ atomtypes ]
  HGA3     1     1.008000    0.000     A  0.238760856462  0.1004160  ; alphatic proton, CH3
  HGP1     1     1.008000    0.000     A  0.040001352445  0.1924640  ; polar H
 CG2O1     6    12.011000    0.000     A  0.356359487256  0.4602400  ; carbonyl C: amides
 CG331     6    12.011000    0.000     A  0.365268474438  0.3263520  ; aliphatic C for methyl group (-CH3)
 NG2S2     7    14.007000    0.000     A  0.329632525712  0.8368000  ; terminal amide nitrogen (CO=NH2)
 OG2D1     8    15.999400    0.000     A  0.302905564168  0.5020800  ; carbonyl O: amides, esters, [neutral] carboxylic acids, aldehydes, uera
